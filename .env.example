# Next.js loads .env.local; it does not load .env.example.
# Keep this template secret-free; put API keys in .env.local.
# local = browser mock; http = real accounts and database.
NEXT_PUBLIC_DATA_SOURCE=http
DEPLOYMENT_ENV=local

# docker compose up -d
DATABASE_URL=postgresql://siroquizz:siroquizz_local_only@localhost:5433/siroquizz
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Only use a header your production gateway overwrites; never trust client-supplied IPs.
TRUSTED_IP_HEADER=x-vercel-forwarded-for

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` to /api/cron/cleanup.
CRON_SECRET=

# Required for production HTTP mode; domain must be verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Optional Google OAuth; set both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for production HTTP mode; set both or neither.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only Groq API key, using the existing project variable name (Phase 3).
GROQ_LLM_API=

# Phase 3: server-only Groq and S3-compatible storage (Supabase Storage / R2 / S3).
# Local leaves S3 unset and uses private .data/uploads instead.
# Supabase example: S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
AI_ENABLED=true
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
