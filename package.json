{
  "name": "siroquizz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:cleanup": "NODE_OPTIONS=--conditions=react-server tsx scripts/cleanup.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "ai:eval": "NODE_OPTIONS=--conditions=react-server tsx scripts/ai-eval.mts",
    "admin:grant": "tsx scripts/grant-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
