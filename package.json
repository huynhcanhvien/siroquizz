    "@hookform/resolvers": "^5.9.1",
    "@napi-rs/canvas": "^1.0.10",
    "@next/env": "^16.3.8",
    "@tanstack/react-query": "^5.104.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.51.0",
    "mammoth": "^1.13.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.14",
    "pdfjs-dist": "^6.4.299",
    "postgres": "^3.4.9",
    "qrcode": "1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "resend": "^6.32.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.2",
    "uuid": "^14.0.2",
